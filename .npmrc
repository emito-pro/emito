shamefully-hoist=false

# Exclude React typings from the shared `.pnpm/node_modules` hoist directory.
#
# The workspace legitimately depends on BOTH `@types/react@19` (the email-template
# stack: `@emito/templates`, `@react-email/*`) and `@types/react@18` (the React-18
# UI packages: `@emito/react`, `@emito/react-native`, the demo SPA client). pnpm hoists ONE of those duplicates into the shared store dir, and the
# tiebreak is non-deterministic across machines/CI. When the React-18 copy wins,
# tsc's `bundler` resolution finds it while *also* loading a package's own
# React-19 copy, double-loading the global `React`/`JSX` namespace and emitting
# spurious `bigint`/`ReactNode` mismatch errors (React 19's `ReactNode` admits
# `bigint`; React 18's does not). Keeping `@types/react*` out of the shared hoist
# dir forces every package to resolve only its OWN declared version, making the
# whole-workspace build deterministic locally and in Docker.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
