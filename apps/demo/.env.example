DATABASE_URL=postgres://emito:emito@localhost:5432/emito_demo
REDIS_URL=redis://localhost:6379
JWT_SECRET=demo-jwt-secret-change-in-production
EMITO_API_KEY=demo-api-key-change-in-production
PORT=3001

# Optional: real email delivery via Resend (https://resend.com — 100 emails/day free)
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM=notifications@yourdomain.com

# Optional: real SMS delivery via Twilio (https://twilio.com)
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_FROM_NUMBER=+15551234567

# Optional: real push notifications via Firebase Cloud Messaging
# FCM_PROJECT_ID=my-project
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxx@my-project.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
# Note: Use literal \n in the key value — the app converts them to real newlines

# Optional: real Slack delivery via incoming webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: real Telegram delivery via bot
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
