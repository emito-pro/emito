{
	"name": "@emito/core",
	"version": "0.1.0",
	"license": "MIT",
	"description": "The Emito notification engine — one send() that resolves the subscriber, applies preference and consent gates, renders localized templates, and routes to provider plugins.",
	"keywords": ["emito", "notifications", "notification-infrastructure", "self-hosted", "notification-engine", "multi-channel", "preferences", "consent", "multi-tenant"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emito-pro/emito.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/emito-pro/emito/tree/main/packages/core#readme",
	"bugs": {
		"url": "https://github.com/emito-pro/emito/issues"
	},
	"author": "SFER LABS LLC",
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"scripts": {
		"build": "tsc --project tsconfig.build.json && node ../../scripts/add-js-extensions.mjs dist",
		"test": "vitest run --coverage",
		"check": "tsc --noEmit",
		"lint": "biome check src/"
	},
	"dependencies": {
		"@emito/types": "workspace:*",
		"ioredis": "^5.4.0",
		"@opentelemetry/api": "^1.9.0",
		"pino": "^9.6.0",
		"prom-client": "^15.1.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "^10.0.0",
		"@vitest/coverage-v8": "^3.0.0",
		"testcontainers": "^10.0.0",
		"typescript": "^7.0.2",
		"vitest": "^3.0.0"
	}
}
