{
	"name": "@emito/js",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Browser and Node client for Emito — notification, preference, and subscription APIs over WebSocket, SSE, or polling.",
	"keywords": ["emito", "notifications", "notification-infrastructure", "self-hosted", "sdk", "client", "websocket", "sse", "in-app-notifications"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emito-pro/emito.git",
		"directory": "packages/js"
	},
	"homepage": "https://github.com/emito-pro/emito/tree/main/packages/js#readme",
	"bugs": {
		"url": "https://github.com/emito-pro/emito/issues"
	},
	"author": "SFER LABS LLC",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"test": "vitest run --coverage",
		"check": "tsc --noEmit",
		"lint": "biome check src/"
	},
	"dependencies": {
		"@emito/types": "workspace:*"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^3.0.0",
		"typescript": "^7.0.2",
		"vitest": "^3.0.0"
	}
}
