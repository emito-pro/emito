{
	"name": "@emito/templates",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Localized, channel-shaped notification templates for Emito — locale resolution plus email, Slack, and Telegram formatters.",
	"keywords": ["emito", "notifications", "notification-infrastructure", "self-hosted", "templates", "i18n", "react-email", "localization"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emito-pro/emito.git",
		"directory": "packages/templates"
	},
	"homepage": "https://github.com/emito-pro/emito/tree/main/packages/templates#readme",
	"bugs": {
		"url": "https://github.com/emito-pro/emito/issues"
	},
	"author": "SFER LABS LLC",
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"test": "vitest run --coverage --testTimeout=20000",
		"check": "tsc --noEmit",
		"lint": "biome check src/"
	},
	"dependencies": {
		"@emito/types": "workspace:*",
		"@react-email/components": "^0.0.36",
		"@react-email/render": "^1.0.5"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@vitest/coverage-v8": "^4.1.11",
		"typescript": "^5.8.0",
		"vitest": "^3.0.0"
	}
}
