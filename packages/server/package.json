{
	"name": "@emito/server",
	"version": "0.1.0",
	"license": "MIT",
	"description": "The Emito HTTP API — createEmitoServer with Node, Fastify, Express, Next.js, and Hono adapters, plus native in-app delivery and inbound provider webhooks.",
	"keywords": ["emito", "notifications", "notification-infrastructure", "self-hosted", "http-api", "fastify", "express", "nextjs", "hono", "websocket", "sse", "webhooks"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emito-pro/emito.git",
		"directory": "packages/server"
	},
	"homepage": "https://github.com/emito-pro/emito/tree/main/packages/server#readme",
	"bugs": {
		"url": "https://github.com/emito-pro/emito/issues"
	},
	"author": "SFER LABS LLC",
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/adapters/node.d.ts",
			"import": "./dist/adapters/node.js"
		},
		"./nextjs": {
			"types": "./dist/adapters/nextjs.d.ts",
			"import": "./dist/adapters/nextjs.js"
		},
		"./fastify": {
			"types": "./dist/adapters/fastify.d.ts",
			"import": "./dist/adapters/fastify.js"
		},
		"./express": {
			"types": "./dist/adapters/express.d.ts",
			"import": "./dist/adapters/express.js"
		},
		"./hono": {
			"types": "./dist/adapters/hono.d.ts",
			"import": "./dist/adapters/hono.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist"],
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"test": "vitest run",
		"check": "tsc --noEmit",
		"lint": "biome check src/"
	},
	"dependencies": {
		"@emito/core": "workspace:*",
		"@emito/types": "workspace:*",
		"ws": "^8.21.3",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^3.0.0",
		"fastify": "^5.8.4",
		"hono": "^4.9.0",
		"typescript": "^5.8.0",
		"vitest": "^3.0.0"
	}
}
