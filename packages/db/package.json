{
	"name": "@emito/db",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Postgres schema, Drizzle client, repositories, and the canonical SQL migrations for Emito.",
	"keywords": ["emito", "notifications", "notification-infrastructure", "self-hosted", "drizzle", "postgres", "migrations", "schema"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emito-pro/emito.git",
		"directory": "packages/db"
	},
	"homepage": "https://github.com/emito-pro/emito/tree/main/packages/db#readme",
	"bugs": {
		"url": "https://github.com/emito-pro/emito/issues"
	},
	"author": "SFER LABS LLC",
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./drizzle": "./drizzle",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist", "drizzle"],
	"scripts": {
		"build": "tsc --project tsconfig.build.json && node ../../scripts/add-js-extensions.mjs dist",
		"test": "vitest run --coverage",
		"check": "tsc --noEmit",
		"lint": "biome check src/",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@emito/types": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"uuidv7": "^1.0.0"
	},
	"devDependencies": {
		"@emito/core": "workspace:*",
		"@testcontainers/postgresql": "^10.0.0",
		"@vitest/coverage-v8": "^3.0.0",
		"drizzle-kit": "^0.31.0",
		"testcontainers": "^10.0.0",
		"typescript": "^5.8.0",
		"vitest": "^3.0.0"
	}
}
