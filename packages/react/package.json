{
	"name": "@emito/react",
	"version": "0.1.0",
	"license": "MIT",
	"description": "React components for Emito in-app notifications — inbox, bell, toasts, and preference UI.",
	"keywords": ["emito", "notifications", "notification-infrastructure", "self-hosted", "react", "components", "notification-inbox", "in-app-notifications"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emito-pro/emito.git",
		"directory": "packages/react"
	},
	"homepage": "https://github.com/emito-pro/emito/tree/main/packages/react#readme",
	"bugs": {
		"url": "https://github.com/emito-pro/emito/issues"
	},
	"author": "SFER LABS LLC",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./index.css": "./dist/index.css"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"test": "vitest run --coverage",
		"check": "tsc --noEmit",
		"lint": "biome check src/"
	},
	"dependencies": {
		"@emito/js": "workspace:*",
		"@emito/react-hooks": "workspace:*",
		"@emito/types": "workspace:*",
		"@floating-ui/react": "^0.27.0"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.6",
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0",
		"@vitest/coverage-v8": "^3.0.0",
		"jsdom": "^25.0.0",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"typescript": "^5.8.0",
		"vitest": "^3.0.0",
		"vite": "^6.4.2",
		"@vitejs/plugin-react": "^4.7.0"
	}
